{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orbita.dev/schemas/lane-tickets/verbs/ticket_update_charter.request.schema.json",
  "title": "ticket_update_charter request",
  "type": "object",
  "required": ["ticket_id", "charter_patch"],
  "additionalProperties": false,
  "properties": {
    "ticket_id": {
      "$ref": "../common.schema.json#/definitions/uuid"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "$ref": "../common.schema.json#/definitions/idempotency_key"
    },
    "charter_patch": {
      "type": "object",
      "description": "Partial mandate charter update; hard_limits and assigned_principals require founder."
    }
  }
}
