{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orbita.dev/schemas/lane-tickets/verbs/ticket_block.request.schema.json",
  "title": "ticket_block request",
  "type": "object",
  "required": ["ticket_id", "actor", "blocked_on"],
  "additionalProperties": false,
  "properties": {
    "ticket_id": { "$ref": "../common.schema.json#/definitions/uuid" },
    "expected_version": { "type": "integer", "minimum": 1 },
    "blocked_on": { "type": "string", "minLength": 1 },
    "idempotency_key": { "$ref": "../common.schema.json#/definitions/idempotency_key" },
    "actor": { "$ref": "../common.schema.json#/definitions/actor" },
    "note": { "type": "string" }
  }
}
