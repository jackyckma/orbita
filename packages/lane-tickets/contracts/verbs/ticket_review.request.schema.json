{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orbita.dev/schemas/lane-tickets/verbs/ticket_review.request.schema.json",
  "title": "ticket_review request",
  "type": "object",
  "required": ["ticket_id", "review_outcome"],
  "additionalProperties": false,
  "properties": {
    "ticket_id": {
      "$ref": "../common.schema.json#/definitions/uuid"
    },
    "review_outcome": {
      "$ref": "../common.schema.json#/definitions/review_outcome"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "$ref": "../common.schema.json#/definitions/idempotency_key"
    },
    "comment": {
      "type": "string"
    }
  }
}
