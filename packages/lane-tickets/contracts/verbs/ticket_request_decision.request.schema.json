{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orbita.dev/schemas/lane-tickets/verbs/ticket_request_decision.request.schema.json",
  "title": "ticket_request_decision request",
  "type": "object",
  "required": ["ticket_id", "actor", "question"],
  "additionalProperties": false,
  "properties": {
    "ticket_id": { "$ref": "../common.schema.json#/definitions/uuid" },
    "expected_version": { "type": "integer", "minimum": 1 },
    "question": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_tier": { "$ref": "../common.schema.json#/definitions/risk_tier" },
    "idempotency_key": { "$ref": "../common.schema.json#/definitions/idempotency_key" },
    "actor": { "$ref": "../common.schema.json#/definitions/actor" }
  }
}
