{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orbita.dev/schemas/lane-tickets/verbs/ticket_progress.request.schema.json",
  "title": "ticket_progress request",
  "type": "object",
  "required": ["ticket_id", "actor"],
  "additionalProperties": false,
  "properties": {
    "ticket_id": { "$ref": "../common.schema.json#/definitions/uuid" },
    "expected_version": { "type": "integer", "minimum": 1 },
    "status": { "$ref": "../common.schema.json#/definitions/work_status" },
    "next_action": { "type": "string" },
    "owner": { "$ref": "../common.schema.json#/definitions/owner" },
    "idempotency_key": { "$ref": "../common.schema.json#/definitions/idempotency_key" },
    "actor": { "$ref": "../common.schema.json#/definitions/actor" },
    "note": { "type": "string" }
  }
}
