{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orbita.dev/schemas/lane-tickets/common.schema.json",
  "title": "Lane tickets — shared definitions",
  "definitions": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "description": "Tenant id from auth context only — never from request bodies alone."
    },
    "iso_date_time": {
      "type": "string",
      "format": "date-time"
    },
    "iso_date": {
      "type": "string",
      "format": "date"
    },
    "ticket_kind": {
      "type": "string",
      "enum": ["mandate", "epic", "task", "decision"]
    },
    "ticket_function": {
      "type": "string",
      "enum": ["dev", "infra", "support", "marketing", "sales", "ops", "research"]
    },
    "risk_tier": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "money"]
    },
    "ticket_source": {
      "type": "string",
      "enum": ["native", "git"]
    },
    "sync_state": {
      "type": "string",
      "enum": ["confirmed", "pending-sync", "drift"]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "human | claude | agent:<name>"
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "enforcement": {
      "type": "string",
      "enum": ["server", "environment", "instruction"],
      "description": "How a hard_limit is enforced: server (Orbita rejects), environment (capability absent), instruction (policy text only)."
    },
    "mandate_status": {
      "type": "string",
      "enum": ["draft", "active", "paused", "retired"]
    },
    "epic_status": {
      "type": "string",
      "enum": ["proposed", "approved", "active", "done", "cancelled"]
    },
    "work_status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "claimed",
        "in_progress",
        "in_review",
        "done",
        "waiting_human",
        "blocked",
        "cancelled"
      ]
    },
    "ticket_verb": {
      "type": "string",
      "enum": [
        "ticket_create",
        "ticket_list",
        "ticket_get",
        "ticket_approve",
        "ticket_claim",
        "ticket_extend",
        "ticket_progress",
        "ticket_complete",
        "ticket_block",
        "ticket_request_decision",
        "ticket_comment",
        "ticket_cancel",
        "ticket_update_charter",
        "ticket_review",
        "ticket_propose",
        "ticket_resolve"
      ]
    },
    "decision_class": {
      "type": "string",
      "enum": ["question", "proposal"]
    },
    "proposal_type": {
      "type": "string",
      "enum": [
        "process_change",
        "task_type_request",
        "charter_change_request",
        "access_or_tool_request",
        "cross_agent_suggestion",
        "other"
      ]
    },
    "proposal_resolve_outcome": {
      "type": "string",
      "enum": ["accepted", "declined", "needs_info", "deferred"]
    },
    "proposal_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mandate_id": { "$ref": "#/definitions/uuid" },
        "ticket_id": { "$ref": "#/definitions/uuid" }
      }
    },
    "ticket_input_ref": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["note", "url", "ticket", "chat"]
        },
        "ref": { "type": "string", "minLength": 1 },
        "from": { "type": "string" }
      }
    },
    "proposal_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "founder_only_types": {
          "type": "array",
          "items": { "$ref": "#/definitions/proposal_type" }
        }
      }
    },
    "task_class": {
      "type": "string",
      "enum": ["planned", "exception"],
      "default": "planned"
    },
    "review_outcome": {
      "type": "string",
      "enum": ["accepted", "needs_changes", "cancel"]
    },
    "actor": {
      "type": "object",
      "required": ["role"],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": ["founder", "integrator", "executor", "system"]
        },
        "principal_id": {
          "$ref": "#/definitions/principal_id"
        },
        "api_key_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pagination_cursor": {
      "type": "string",
      "minLength": 1
    },
    "error_envelope": {
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message", "request_id"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "request_id": { "type": "string", "minLength": 1 },
            "details": { "type": "object" }
          }
        }
      }
    }
  }
}
