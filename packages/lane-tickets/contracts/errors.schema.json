{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orbita.dev/schemas/lane-tickets/errors.schema.json",
  "title": "Ticket API errors",
  "definitions": {
    "git_read_only": {
      "allOf": [
        { "$ref": "common.schema.json#/definitions/error_envelope" },
        {
          "properties": {
            "error": {
              "properties": {
                "code": { "const": "GIT_READ_ONLY" },
                "details": {
                  "type": "object",
                  "required": ["git_ref", "message"],
                  "additionalProperties": false,
                  "properties": {
                    "git_ref": { "type": "string", "minLength": 1 },
                    "message": {
                      "type": "string",
                      "const": "Tickets with source=git are read-only in Orbita; mutate the git file instead."
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "description": "HTTP 409 when any transition verb is attempted on a git-sourced ticket."
    }
  }
}
