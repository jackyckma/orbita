{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orbita.dev/schemas/lane-tickets/errors.schema.json",
  "title": "Ticket API errors",
  "definitions": {
    "git_read_only": {
      "allOf": [
        { "$ref": "common.schema.json#/definitions/error_envelope" },
        {
          "properties": {
            "error": {
              "properties": {
                "code": { "const": "GIT_READ_ONLY" },
                "details": {
                  "type": "object",
                  "required": ["git_ref", "message"],
                  "additionalProperties": false,
                  "properties": {
                    "git_ref": { "type": "string", "minLength": 1 },
                    "message": {
                      "type": "string",
                      "const": "Tickets with source=git are read-only in Orbita; mutate the git file instead."
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "description": "HTTP 409 when any transition verb is attempted on a git-sourced ticket."
    },
    "mandate_not_active": {
      "allOf": [
        { "$ref": "common.schema.json#/definitions/error_envelope" },
        {
          "properties": {
            "error": {
              "properties": {
                "code": { "const": "MANDATE_NOT_ACTIVE" }
              }
            }
          }
        }
      ],
      "description": "Agent mutation blocked while ancestor mandate is draft, paused, or retired."
    },
    "outside_mandate": {
      "allOf": [
        { "$ref": "common.schema.json#/definitions/error_envelope" },
        {
          "properties": {
            "error": {
              "properties": {
                "code": { "const": "OUTSIDE_MANDATE" }
              }
            }
          }
        }
      ],
      "description": "Agent actor mandate_ids does not include the ticket mandate."
    },
    "invalid_parent": {
      "allOf": [
        { "$ref": "common.schema.json#/definitions/error_envelope" },
        {
          "properties": {
            "error": {
              "properties": {
                "code": { "const": "INVALID_PARENT" }
              }
            }
          }
        }
      ],
      "description": "ticket_create parent kind/status violates hierarchy rules."
    },
    "hard_limit_counters_missing": {
      "allOf": [
        { "$ref": "common.schema.json#/definitions/error_envelope" },
        {
          "properties": {
            "error": {
              "properties": {
                "code": { "const": "HARD_LIMIT_COUNTERS_MISSING" }
              }
            }
          }
        }
      ],
      "description": "Charter has server hard_limits but caller omitted mandate counters."
    },
    "soft_block_threshold_exceeded": {
      "allOf": [
        { "$ref": "common.schema.json#/definitions/error_envelope" },
        {
          "properties": {
            "error": {
              "properties": {
                "code": { "const": "SOFT_BLOCK_THRESHOLD_EXCEEDED" }
              }
            }
          }
        }
      ],
      "description": "Observed metric crossed a soft_constraint block_threshold."
    },
    "role_required": {
      "allOf": [
        { "$ref": "common.schema.json#/definitions/error_envelope" },
        {
          "properties": {
            "error": {
              "properties": {
                "code": { "const": "ROLE_REQUIRED" },
                "details": {
                  "type": "object",
                  "required": ["required_roles"],
                  "additionalProperties": true,
                  "properties": {
                    "required_roles": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": ["founder", "integrator"]
                      },
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Mandate lifecycle or other role-gated transition denied for the actor role."
    },
    "precheck_failed": {
      "allOf": [
        { "$ref": "common.schema.json#/definitions/error_envelope" },
        {
          "properties": {
            "error": {
              "properties": {
                "code": { "const": "PRECHECK_FAILED" }
              }
            }
          }
        }
      ],
      "description": "Epic approve precheckEpic failed and override_precheck was not supplied."
    }
  }
}
