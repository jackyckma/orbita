{
  "tools": [
    {
      "name": "github_get_file",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1,
            "description": "owner/repo"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "description": "Branch, tag, or sha (default: repo default branch)"
          }
        },
        "required": [
          "repo",
          "path"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "github_list_commits",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1,
            "description": "owner/repo"
          },
          "branch": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "since": {
            "type": "string",
            "description": "ISO-8601 date filter"
          }
        },
        "required": [
          "repo"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "github_list_pull_requests",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1,
            "description": "owner/repo"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "all"
            ]
          }
        },
        "required": [
          "repo"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "memory_get",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "memory_list",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "memory_put",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "content"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "note_get",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "note_link",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from_id": {
            "type": "string",
            "format": "uuid"
          },
          "to_id": {
            "type": "string",
            "format": "uuid"
          },
          "rel": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from_id",
          "to_id",
          "rel"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "note_links",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "note_list",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "note_neighbors",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "include_incoming": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "note_put",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "frontmatter": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "body"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "note_search",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "orbita_whoami",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "portfolio_brief",
      "inputSchema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "minLength": 1,
            "description": "ISO-8601 inclusive lower bound on report updated_at"
          },
          "until": {
            "type": "string",
            "description": "ISO-8601 exclusive upper bound (default: now UTC)"
          },
          "project": {
            "type": "string",
            "description": "Optional project slug filter (enabled registry projects only)"
          }
        },
        "required": [
          "since"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "trigger_automation",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lane": {
            "type": "string",
            "enum": [
              "maker",
              "checker"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "lane",
          "reason"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}
